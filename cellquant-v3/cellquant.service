[Unit]
Description=CellQuant Analysis Service (v3)
Documentation=https://github.com/anthropics/cellquant
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10

# Adjust this path to wherever you clone the repo
WorkingDirectory=/opt/cellquant

# Load secrets from .env (JWT_SECRET, ADMIN_PASSWORD)
EnvironmentFile=/opt/cellquant/.env

ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up --remove-orphans
ExecStop=/usr/bin/docker compose down

# Give containers 30 s to stop cleanly
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
